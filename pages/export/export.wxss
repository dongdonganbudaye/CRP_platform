/* pages/export/export.wxss */
.container {
  min-height: 100vh;
  background-color: #ffffff;
  padding: 60rpx;
}

.form-container {
  width: 100%;
}

.form-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #587558;
  margin-bottom: 20rpx;
  text-align: center;
}

.form-subtitle {
  font-size: 28rpx;
  color: #999999;
  margin-bottom: 60rpx;
  text-align: center;
}

.form-group {
  margin-bottom: 40rpx;
}

.label {
  font-size: 30rpx;
  color: #333333;
  margin-bottom: 20rpx;
  font-weight: 500;
}

.input {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 10rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  background-color: #fafafa;
}

.login-button {
  width: 100%;
  height: 90rpx;
  background-color: #587558;
  color: #ffffff;
  font-size: 32rpx;
  border: none;
  border-radius: 15rpx;
  margin-top: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-button::after {
  border: none;
}

.export-container {
  width: 100%;
}

.export-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #587558;
  margin-bottom: 60rpx;
  text-align: center;
}

.stats-container {
  background-color: #f8f8f8;
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 60rpx;
}

.stat-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
  padding-bottom: 30rpx;
  border-bottom: 1rpx solid #e0e0e0;
}

.stat-item:last-child {
  margin-bottom: 0;
  padding-bottom: 0;
  border-bottom: none;
}

.stat-item.total {
  background-color: #587558;
  border-radius: 10rpx;
  padding: 20rpx 30rpx;
  border-bottom: none;
}

.stat-item.total .stat-label,
.stat-item.total .stat-value {
  color: #ffffff;
}

.stat-label {
  font-size: 30rpx;
  color: #666666;
}

.stat-value {
  font-size: 34rpx;
  font-weight: bold;
  color: #587558;
}

.button-group {
  margin-bottom: 40rpx;
}

.export-button {
  width: 100%;
  height: 90rpx;
  background-color: #587558;
  color: #ffffff;
  font-size: 30rpx;
  border: none;
  border-radius: 15rpx;
  margin-bottom: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.export-button:last-child {
  margin-bottom: 0;
}

.export-button::after {
  border: none;
}

.logout-button {
  width: 100%;
  height: 80rpx;
  background-color: #ffffff;
  color: #999999;
  font-size: 28rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 15rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.logout-button::after {
  border: none;
}

