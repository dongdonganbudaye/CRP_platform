/* pages/index/index.wxss */
.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  background-color: #ffffff;
  padding: 0 60rpx;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #587558;
  margin-bottom: 100rpx;
  text-align: center;
}

.button-container {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 40rpx;
}

.action-button {
  width: 100%;
  height: 100rpx;
  background-color: #587558;
  color: #ffffff;
  font-size: 36rpx;
  border: none;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background-color 0.1s;
}

.action-button.active {
  background-color: #FFB414;
}

.action-button::after {
  border: none;
}

