/* pages/success/success.wxss */
.container {
  min-height: 100vh;
  background-color: #ffffff;
  padding: 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.success-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background-color: #587558;
  color: #ffffff;
  font-size: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
}

.success-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #587558;
  margin-bottom: 80rpx;
}

.info-container {
  width: 100%;
  background-color: #f8f8f8;
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 80rpx;
}

.info-item {
  margin-bottom: 30rpx;
}

.info-item:last-child {
  margin-bottom: 0;
}

.info-label {
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 10rpx;
}

.info-value {
  font-size: 30rpx;
  color: #333333;
  font-weight: 500;
}

.back-button {
  width: 100%;
  height: 90rpx;
  background-color: #587558;
  color: #ffffff;
  font-size: 32rpx;
  border: none;
  border-radius: 15rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-button::after {
  border: none;
}

